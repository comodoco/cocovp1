{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cocovp1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d655783c-30e4-4a75-8ba4-3fc69dd347b3","database_name": "cocovp1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "eaedcc8dbc644138bf3971a4a0033ab9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
